---
const sections = [
  { name: "South Africa", url: "/south-africa/" },
  { name: "World", url: "/world/" },
  { name: "Politics", url: "/politics/" },
  { name: "Markets & Forex", url: "/markets-forex/" },
  { name: "Sport", url: "/sport/" },
  { name: "Technology", url: "/technology/" },
  { name: "Jobs", url: "/jobs/" },
  { name: "Weather", url: "/weather/" },
  { name: "Economic Calendar", url: "/economic-calendar/" },
];
---
<html lang="en">
<head><meta charset="UTF-8" /><title>SA Jobs | SA News Hub</title></head>
<body style="font-family:Arial; margin:0; background:#f3f5f9;">
  <header style="background:#101a2d; color:#fff; padding:20px;">
    <a href="/" style="color:#fff; font-size:22px; font-weight:900; text-decoration:none;">SA NEWS HUB.</a>
    <nav style="display:flex; gap:16px; flex-wrap:wrap; margin-top:12px;">
      {sections.map((s) => (<a href={s.url} style="color:#dce4f0; font-size:12px; text-decoration:none;">{s.name}</a>))}
    </nav>
  </header>
  <main style="max-width:900px; margin:0 auto; padding:24px;">
    <h1>SA Jobs - Who Is Hiring?</h1>
    <p>If you can see this, the file is working.</p>
    <input id="jobSearch" type="text" placeholder="Search jobs, e.g. SAPS, Durban..." style="width:100%; padding:12px; border-radius:8px; border:1px solid #ccc;" />
    <div id="jobList" style="margin-top:16px;"></div>
  </main>
  <script>
    const jobs = [
      { title: "SAPS Police Trainees", company: "SAPS", location: "Nationwide" },
      { title: "Cashiers - Checkers", company: "Shoprite", location: "Gqeberha" },
      { title: "Transnet Apprenticeship", company: "Transnet", location: "Durban" },
    ];
    function render(){
      const q = (document.getElementById("jobSearch").value || "").toLowerCase();
      const f = jobs.filter(j => (j.title + " " + j.company + " " + j.location).toLowerCase().includes(q));
      document.getElementById("jobList").innerHTML = f.map(j => `<div style="background:#fff; padding:16px; border-radius:8px; margin-bottom:10px;"><strong>${j.title}</strong><br>${j.company} - ${j.location}</div>`).join("");
    }
    document.getElementById("jobSearch").addEventListener("input", render);
    render();
  </script>
</body>
</html>
