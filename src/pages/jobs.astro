---
import Layout from "../layouts/Layout.astro";
import jobsData from "../data/jobs.json";

const allJobs = jobsData.jobs || [];
const provinces = ["All", "Nationwide", "Gauteng", "Western Cape", "KwaZulu-Natal", "Eastern Cape", "Limpopo", "Mpumalanga", "North West", "Free State", "Northern Cape"];
const updatedDate = new Date(jobsData.updated).toLocaleString("en-ZA", { timeZone: "Africa/Johannesburg" });
---

<Layout title="Jobs in South Africa - SA News Hub">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-2">Jobs in South Africa</h1>
    <p class="text-gray-600 mb-1">✅ {allJobs.length} verified jobs • Updated: {updatedDate} • Auto-updated daily at 06:00</p>
    <p class="text-sm text-green-700 bg-green-50 p-3 rounded mb-6">⚠️ Never pay to apply for a job. If anyone asks for money on WhatsApp/Telegram, it's a scam.</p>

    <div class="flex flex-wrap gap-2 mb-6" id="filters">
      {provinces.map(p => (
        <button data-filter={p} class="filter-btn px-4 py-2 rounded-full border text-sm hover:bg-black hover:text-white">{p}</button>
      ))}
    </div>

    <div id="jobs-list" class="grid gap-4">
      {allJobs.map(job => (
        <article class="job-card border rounded-xl p-5 bg-white shadow-sm" data-province={job.province}>
          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-lg font-bold">{job.title}</h2>
              <p class="text-gray-600">{job.company} • {job.location} • {job.type}</p>
              <span class="inline-block text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded mt-2">{job.province} • {job.category}</span>
              <span class="inline-block text-xs bg-gray-100 px-2 py-1 rounded mt-2 ml-1">{job.source}</span>
            </div>
            <a href={job.link} target="_blank" rel="noopener" class="bg-black text-white px-4 py-2 rounded-lg text-sm whitespace-nowrap ml-4">Apply →</a>
          </div>
          {job.description && <p class="text-sm text-gray-700 mt-3">{job.description}</p>}
        </article>
      ))}
    </div>
  </main>

  <script>
    const btns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.job-card');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-filter');
        btns.forEach(b => b.classList.remove('bg-black','text-white'));
        btn.classList.add('bg-black','text-white');
        cards.forEach(c => {
          const prov = c.getAttribute('data-province');
          c.style.display = (f === 'All' || prov === f) ? 'block' : 'none';
        });
      });
    });
  </script>
</Layout>
