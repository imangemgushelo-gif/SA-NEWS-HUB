---
const sections = [
  { name: "South Africa", url: "/south-africa/" },
  { name: "World", url: "/world/" },
  { name: "Markets & Forex", url: "/markets-forex/" },
  { name: "Sport", url: "/sport/" },
  { name: "Technology", url: "/technology/" },
  { name: "Economic Calendar", url: "/economic-calendar/" }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="South African news, world news, markets, sport and technology." />
    <title>SA News Hub | News that matters</title>
  </head>
  <body>
    <header>
      <p class="brand">SA NEWS <span>HUB</span></p>
      <p class="tagline">News that matters. Markets that move.</p>
      <nav aria-label="Main navigation">
        {sections.map((section) => (
          <a href={section.url}>{section.name}</a>
        ))}
      </nav>
    </header>

    <main>
      <section class="welcome">
        <p class="eyebrow">YOUR DAILY BRIEFING</p>
        <h1>Stay informed.<br />Stay ahead.</h1>
        <p>South African stories, global events and the numbers shaping your day.</p>
      </section>

      <section id="news">
        <p class="eyebrow">EXPLORE THE LATEST</p>
        <h2>Your news, all in one place</h2>

        <div class="grid">
          {sections.map((section, index) => (
            <a class="tile" href={section.url}>
              <p class="number">0{index + 1}</p>
              <h3>{section.name}</h3>
              <p>Explore the latest {section.name.toLowerCase()} updates.</p>
              <span class="read-more">Explore section →</span>
            </a>
          ))}
        </div>
      </section>

      <p class="note">
        Your daily destination for trusted news and useful market information.
      </p>
    </main>

    <footer>© 2026 SA News Hub · Independent news project</footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #f5f7fb;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
  }
  header { background: #101d36; color: white; padding: 24px 6%; }
  .brand { font-size: 27px; font-weight: 900; letter-spacing: 1px; margin: 0; }
  .brand span { color: #ffbd59; }
  .tagline { color: #c6d0e0; font-size: 14px; }
  nav { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 22px; }
  nav a { color: white; text-decoration: none; font-size: 14px; }
  nav a:hover { color: #ffbd59; }
  main { max-width: 1050px; margin: auto; padding: 28px 20px 50px; }
  .welcome { background: #18345c; color: white; padding: 36px 28px; border-radius: 18px; }
  .eyebrow { color: #c17b16; font-size: 12px; font-weight: bold; letter-spacing: 2px; }
  .welcome .eyebrow { color: #ffcf83; }
  h1 { font-size: clamp(36px, 8vw, 62px); line-height: 1.05; margin: 14px 0; }
  .welcome > p:last-child { line-height: 1.6; max-width: 500px; color: #e1e9f5; }
  h2 { font-size: 26px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .tile {
    display: block;
    background: white;
    color: #172033;
    border: 1px solid #e1e6ef;
    border-radius: 14px;
    padding: 20px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .tile:hover { transform: translateY(-3px); box-shadow: 0 8px 22px #17203314; }
  .number { color: #c17b16; font-weight: bold; }
  .tile h3 { margin-bottom: 8px; }
  .tile > p:last-of-type, .note { color: #647086; line-height: 1.6; }
  .read-more { color: #176b45; font-size: 14px; font-weight: bold; }
  .note { margin-top: 28px; }
  footer { background: #101d36; color: #c6d0e0; padding: 24px 6%; font-size: 13px; }

  @media (max-width: 480px) {
    .welcome { padding: 28px 20px; }
    nav { gap: 14px; }
  }
</style>
