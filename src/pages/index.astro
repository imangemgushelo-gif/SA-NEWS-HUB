
---
const sections = [
  {
    name: "South Africa",
    short: "SA",
    url: "/south-africa/",
    description: "The stories shaping our nation.",
    number: "01"
  },
  {
    name: "World",
    short: "GL",
    url: "/world/",
    description: "The latest from across the globe.",
    number: "02"
  },
  {
    name: "Markets & Forex",
    short: "FX",
    url: "/markets-forex/",
    description: "Currencies, markets and money.",
    number: "03"
  },
  {
    name: "Sport",
    short: "SP",
    url: "/sport/",
    description: "Scores, teams and sporting moments.",
    number: "04"
  },
  {
    name: "Technology",
    short: "TECH",
    url: "/technology/",
    description: "Innovation shaping tomorrow.",
    number: "05"
  },
  {
    name: "Economic Calendar",
    short: "EC",
    url: "/economic-calendar/",
    description: "Key economic events to watch.",
    number: "06"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SA News Hub brings together South African news, world events, markets, sport, technology and economic updates."
    />
    <meta name="theme-color" content="#101a2d" />
    <title>SA News Hub | News that matters</title>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="SA News Hub home">
          SA NEWS <span>HUB.</span>
        </a>

        <p class="tagline">NEWS THAT MATTERS. MARKETS THAT MOVE.</p>

        <nav aria-label="Main navigation">
          {sections.map((section) => (
            <a href={section.url}>{section.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow"><span class="live-dot"></span> YOUR DAILY BRIEFING</p>
          <h1>The world moves.<br />Stay <span>informed.</span></h1>
          <p class="hero-copy">
            South African headlines, global developments and the market
            movements that matter — all in one place.
          </p>
          <a class="hero-button" href="#sections">
            Explore the news <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="hero-side" aria-label="About SA News Hub">
          <div class="side-line"></div>
          <p class="side-label">YOUR NEWS. YOUR WORLD.</p>
          <p class="side-title">Clarity in a world that never stands still.</p>
          <p class="side-copy">
            Explore our coverage across six essential categories.
          </p>
          <span class="side-mark">SA / HUB</span>
        </div>
      </section>

      <section class="intro" id="sections">
        <div>
          <p class="eyebrow">THE NEWSROOM</p>
          <h2>Explore the latest.</h2>
        </div>
        <p class="intro-copy">
          Six essential sections. One place to stay connected.
        </p>
      </section>

      <section class="news-grid" aria-label="News categories">
        {sections.map((section) => (
          <a class="news-card" href={section.url}>
            <div class="card-top">
              <span class="card-number">{section.number}</span>
              <span class="card-symbol">{section.short}</span>
            </div>
            <div class="card-bottom">
              <h3>{section.name}</h3>
              <p>{section.description}</p>
              <span class="card-link">Explore section <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </section>

      <section class="closing">
        <div>
          <p class="eyebrow">SA NEWS HUB</p>
          <h2>Stay curious.<br />Stay ahead.</h2>
        </div>
        <p>
          Your daily destination for South African news, global stories and
          useful market information.
        </p>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="/">SA NEWS <span>HUB.</span></a>
      <p>Independent news project · © 2026 SA News Hub</p>
      <a href="#top" class="back-top">Back to top ↑</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f4f6fa;
    color: #172238;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .site-header {
    background: #101a2d;
    color: #fff;
  }

  .header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  .brand,
  .footer-brand {
    display: inline-block;
    color: #fff;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 1.2px;
    text-decoration: none;
  }

  .brand span,
  .footer-brand span {
    color: #ffc66d;
  }

  .tagline {
    margin: 8px 0 23px;
    color: #aebbd0;
    font-size: 10px;
    letter-spacing: 2px;
    line-height: 1.6;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    border-top: 1px solid #ffffff1c;
  }

  nav a {
    padding: 17px 0;
    color: #dce4f0;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: #ffc66d;
  }

  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 30px 24px 60px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 28px;
    overflow: hidden;
    min-height: 340px;
    padding: 40px;
    border-radius: 8px;
    background:
      radial-gradient(ellipse at 90% 0%, #284c78 0%, transparent 48%),
      linear-gradient(125deg, #142745, #101a2d 70%);
    color: #fff;
  }

  .hero-content {
    align-self: center;
  }

  .eyebrow {
    margin: 0 0 17px;
    color: #a66a13;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.2px;
  }

  .hero .eyebrow {
    color: #ffcf83;
  }

  .live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: #ffc66d;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 7vw, 65px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.03;
  }

  h1 span {
    color: #ffc66d;
  }

  .hero-copy {
    max-width: 460px;
    margin: 20px 0 25px;
    color: #c7d3e4;
    font-size: 14px;
    line-height: 1.8;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 13px 17px;
    border-radius: 4px;
    background: #ffc66d;
    color: #172238;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  .hero-button span {
    font-size: 18px;
  }

  .hero-button:hover {
    background: #ffda9b;
  }

  .hero-side {
    align-self: center;
    padding: 18px 0 18px 26px;
    border-left: 1px solid #ffffff35;
  }

  .side-line {
    width: 36px;
    height: 3px;
    margin-bottom: 20px;
    background: #ffc66d;
  }

  .side-label {
    color: #b7c7dc;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .side-title {
    max-width: 240px;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.25;
  }

  .side-copy {
    color: #b7c7dc;
    font-size: 12px;
    line-height: 1.7;
  }

  .side-mark {
    display: inline-block;
    margin-top: 17px;
    color: #ffc66d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin: 48px 0 22px;
  }

  .intro .eyebrow {
    margin-bottom: 9px;
  }

  h2 {
    margin: 0;
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -1px;
  }

  .intro-copy {
    max-width: 260px;
    margin: 0 0 4px;
    color: #69758a;
    font-size: 12px;
    line-height: 1.7;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 215px;
    padding: 22px;
    border: 1px solid #e1e6ef;
    border-radius: 7px;
    background: #fff;
    color: #172238;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .news-card:hover {
    transform: translateY(-3px);
    border-color: #d4a052;
    box-shadow: 0 12px 28px #1722380d;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-number {
    color: #a3adbd;
    font-size: 11px;
    font-weight: 700;
  }

  .card-symbol {
    display: grid;
    min-width: 42px;
    height: 34px;
    padding: 0 7px;
    place-items: center;
    border-radius: 4px;
    background: #f1f4f9;
    color: #1a3558;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .card-bottom h3 {
    margin: 23px 0 8px;
    font-size: 19px;
    letter-spacing: -0.4px;
  }

  .card-bottom p {
    margin: 0;
    color: #69758a;
    font-size: 12px;
    line-height: 1.7;
  }

  .card-link {
    display: flex;
    justify-content: space-between;
    margin-top: 19px;
    padding-top: 14px;
    border-top: 1px solid #edf0f5;
    color: #1a6549;
    font-size: 11px;
    font-weight: 800;
  }

  .card-link span {
    font-size: 15px;
  }

  .closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 42px;
    padding: 30px;
    border-radius: 7px;
    background: #e8edf5;
  }

  .closing .eyebrow {
    margin-bottom: 10px;
  }

  .closing h2 {
    font-size: 28px;
    line-height: 1.2;
  }

  .closing > p {
    max-width: 370px;
    color: #58667b;
    font-size: 13px;
    line-height: 1.8;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding: 25px max(24px, calc((100% - 1132px) / 2));
    background: #101a2d;
  }

  .footer-brand {
    font-size: 17px;
  }

  footer p {
    color: #aebbd0;
    font-size: 10px;
    line-height: 1.6;
  }

  .back-top {
    color: #ffc66d;
    font-size: 11px;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .header-inner {
      padding: 21px 18px 0;
    }

    .brand {
      font-size: 23px;
    }

    .tagline {
      font-size: 9px;
      letter-spacing: 1.4px;
    }

    nav {
      gap: 0 17px;
    }

    nav a {
      padding: 13px 0;
      font-size: 11px;
    }

    main {
      padding: 20px 15px 38px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 30px;
      min-height: 0;
      padding: 29px 23px;
    }

    h1 {
      font-size: clamp(39px, 10vw, 57px);
      letter-spacing: -1.5px;
    }

    .hero-copy {
      font-size: 13px;
    }

    .hero-side {
      padding: 20px 0 0;
      border-top: 1px solid #ffffff35;
      border-left: 0;
    }

    .side-title {
      max-width: 300px;
      font-size: 22px;
    }

    .side-mark {
      margin-top: 5px;
    }

    .intro {
      align-items: start;
      flex-direction: column;
      gap: 8px;
      margin-top: 35px;
    }

    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 11px;
    }

    .news-card {
      min-height: 205px;
      padding: 15px;
    }

    .card-bottom h3 {
      font-size: 16px;
    }

    .card-bottom p {
      font-size: 11px;
    }

    .card-link {
      gap: 5px;
      font-size: 10px;
    }

    .closing {
      align-items: start;
      flex-direction: column;
      gap: 10px;
      padding: 24px;
    }

    footer {
      align-items: start;
      flex-direction: column;
      padding: 24px 18px;
      gap: 10px;
    }

    footer p {
      margin: 0;
    }
  }

  @media (max-width: 360px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .news-card {
      min-height: 180px;
    }
  }
</style>
