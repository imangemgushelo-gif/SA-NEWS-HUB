---
import "../styles/page-themes.css";
const sections = [
  {
    name: "South Africa",
    url: "/south-africa/",
    number: "01",
    label: "SA NEWS",
    description: "The stories shaping our nation."
  },
  {
    name: "World",
    url: "/world/",
    number: "02",
    label: "GLOBAL",
    description: "Important developments from around the world."
  },
  {
    name: "Markets & Forex",
    url: "/markets-forex/",
    number: "03",
    label: "MARKETS",
    description: "Currencies, financial markets and money."
  },
  {
    name: "Sport",
    url: "/sport/",
    number: "04",
    label: "SPORT",
    description: "Teams, results and sporting highlights."
  },
  {
    name: "Technology",
    url: "/technology/",
    number: "05",
    label: "TECH",
    description: "New ideas, innovation and digital trends."
  },
  {
    name: "Economic Calendar",
    url: "/economic-calendar/",
    number: "06",
    label: "ECONOMY",
    description: "Economic events and indicators to watch."
  }
];
---

<html lang="en">
  <head>
    <meta name="google-site-verification" content="2RbFof9a2eHgd0C4XOU6Kyw9db23duJCzGwVj6WTzQU" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SA News Hub: South African news, world headlines, markets, forex, sport, technology and economic events."
    />
    <meta name="theme-color" content="#101a2d" />
    <title>SA News Hub | News that matters</title>
  </head>

  <body data-page-theme="home">
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          SA NEWS <span>HUB.</span>
        </a>

        <p class="tagline">NEWS THAT MATTERS. MARKETS THAT MOVE.</p>

        <nav aria-label="Main navigation">
          {sections.map((section) => (
            <a href={section.url}>{section.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">
            <span class="status-dot"></span>
            YOUR DAILY BRIEFING
          </p>

          <h1>Know more.<br />See the <span>bigger picture.</span></h1>

          <p class="hero-description">
            South African stories, global developments and market movements
            — bringing the news that matters together in one place.
          </p>

          <a class="primary-button" href="#sections">
            Explore the news <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="hero-panel">
          <p class="panel-label">WELCOME TO</p>
          <div class="panel-logo">SA<span>/</span>HUB</div>
          <div class="panel-rule"></div>
          <p class="panel-heading">Your world.<br />Your daily briefing.</p>
          <p class="panel-description">
            Six essential categories. One destination.
          </p>
          <span class="panel-index">EST. 2026</span>
        </div>
      </section>

      <section class="section-heading" id="sections">
        <div>
          <p class="eyebrow">THE NEWSROOM</p>
          <h2>Explore our coverage</h2>
        </div>
        <p class="section-description">
          Stay connected to the stories shaping your day.
        </p>
      </section>

      <section class="news-grid" aria-label="News categories">
        {sections.map((section) => (
          <a class="news-card" href={section.url}>
            <div class="card-header">
              <span class="card-number">{section.number}</span>
              <span class="card-label">{section.label}</span>
            </div>

            <div class="card-content">
              <h3>{section.name}</h3>
              <p>{section.description}</p>
            </div>

            <div class="card-footer">
              <span>Explore section</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </section>

      <section class="closing-banner">
        <div>
          <p class="eyebrow">STAY INFORMED</p>
          <h2>Good information<br />changes perspective.</h2>
        </div>
        <a class="closing-link" href="#sections">
          Discover our sections <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="footer-brand" href="/">SA NEWS <span>HUB.</span></a>
      <p>Independent news project · © 2026 SA News Hub</p>
      <a class="footer-top" href="#">Back to top ↑</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f5f9;
    color: #172238;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .site-header {
    background: #101a2d;
    color: #ffffff;
  }

  .header-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  .brand,
  .footer-brand {
    display: inline-block;
    color: #ffffff;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 1px;
    text-decoration: none;
  }

  .brand span,
  .footer-brand span {
    color: #ffc66d;
  }

  .tagline {
    margin: 8px 0 23px;
    color: #aebbd0;
    font-size: 10px;
    letter-spacing: 2px;
    line-height: 1.6;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 23px;
    border-top: 1px solid #ffffff20;
  }

  nav a {
    padding: 16px 0;
    color: #dce4f0;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #ffc66d;
  }

  main {
    max-width: 1160px;
    margin: 0 auto;
    padding: 30px 24px 55px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 32px;
    align-items: center;
    min-height: 350px;
    padding: 42px;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(ellipse at 90% 5%, #2b4a70 0%, transparent 45%),
      linear-gradient(125deg, #183354, #101a2d 75%);
    color: #ffffff;
  }

  .hero-content {
    max-width: 650px;
  }

  .eyebrow {
    margin: 0 0 13px;
    color: #a66a13;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .hero .eyebrow {
    color: #ffcf83;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: #ffc66d;
  }

  h1 {
    margin: 0;
    font-size: clamp(37px, 6vw, 62px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.06;
  }

  h1 span {
    color: #ffc66d;
  }

  .hero-description {
    max-width: 465px;
    margin: 20px 0 25px;
    color: #c7d3e4;
    font-size: 14px;
    line-height: 1.8;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 13px 17px;
    border-radius: 4px;
    background: #ffc66d;
    color: #172238;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  .primary-button:hover {
    background: #ffda9b;
  }

  .primary-button span {
    font-size: 18px;
  }

  .hero-panel {
    padding: 20px 0 20px 28px;
    border-left: 1px solid #ffffff35;
  }

  .panel-label {
    color: #b7c7dc;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .panel-logo {
    margin: 20px 0;
    color: #ffffff;
    font-size: 39px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .panel-logo span {
    color: #ffc66d;
  }

  .panel-rule {
    width: 38px;
    height: 3px;
    background: #ffc66d;
  }

  .panel-heading {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.35;
  }

  .panel-description {
    color: #b7c7dc;
    font-size: 12px;
    line-height: 1.7;
  }

  .panel-index {
    display: inline-block;
    margin-top: 15px;
    color: #ffc66d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin: 47px 0 23px;
  }

  .section-heading .eyebrow {
    margin-bottom: 9px;
  }

  h2 {
    margin: 0;
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -1px;
  }

  .section-description {
    max-width: 270px;
    margin: 0 0 4px;
    color: #69758a;
    font-size: 12px;
    line-height: 1.7;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .news-card {
    display: flex;
    min-width: 0;
    min-height: 215px;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border: 1px solid #e1e6ef;
    border-radius: 7px;
    background: #ffffff;
    color: #172238;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-3px);
    border-color: #d4a052;
    box-shadow: 0 12px 28px #17223810;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .card-number {
    color: #98a4b7;
    font-size: 11px;
    font-weight: 800;
  }

  .card-label {
    padding: 8px 9px;
    border-radius: 4px;
    background: #f0f3f8;
    color: #234263;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .card-content h3 {
    margin: 24px 0 8px;
    font-size: 19px;
    letter-spacing: -0.4px;
    line-height: 1.3;
  }

  .card-content p {
    margin: 0;
    color: #69758a;
    font-size: 12px;
    line-height: 1.7;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 19px;
    padding-top: 14px;
    border-top: 1px solid #edf0f5;
    color: #176447;
    font-size: 11px;
    font-weight: 800;
  }

  .arrow {
    font-size: 16px;
  }

  .closing-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 42px;
    padding: 30px;
    border-radius: 7px;
    background: #e7edf5;
  }

  .closing-banner .eyebrow {
    margin-bottom: 10px;
  }

  .closing-banner h2 {
    font-size: 27px;
    line-height: 1.25;
  }

  .closing-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    padding: 13px 15px;
    border-radius: 4px;
    background: #142c49;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  .closing-link:hover {
    background: #23476e;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding: 25px max(24px, calc((100% - 1112px) / 2));
    background: #101a2d;
  }

  .footer-brand {
    font-size: 17px;
  }

  .site-footer p {
    color: #aebbd0;
    font-size: 10px;
    line-height: 1.6;
  }

  .footer-top {
    color: #ffc66d;
    font-size: 11px;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .header-inner {
      padding: 21px 18px 0;
    }

    .brand {
      font-size: 23px;
    }

    .tagline {
      font-size: 9px;
      letter-spacing: 1.3px;
    }

    nav {
      gap: 0 17px;
    }

    nav a {
      padding: 13px 0;
      font-size: 11px;
    }

    main {
      padding: 20px 15px 38px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      min-height: 0;
      padding: 29px 22px;
    }

    h1 {
      font-size: clamp(38px, 10vw, 54px);
      letter-spacing: -1.5px;
    }

    .hero-description {
      font-size: 13px;
    }

    .hero-panel {
      padding: 20px 0 0;
      border-top: 1px solid #ffffff35;
      border-left: 0;
    }

    .panel-logo {
      margin: 13px 0;
    }

    .panel-heading {
      font-size: 21px;
    }

    .panel-index {
      margin-top: 5px;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 8px;
      margin-top: 35px;
    }

    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 11px;
    }

    .news-card {
      min-height: 205px;
      padding: 15px;
    }

    .card-content h3 {
      font-size: 16px;
    }

    .card-content p {
      font-size: 11px;
    }

    .card-label {
      padding: 7px;
      font-size: 8px;
    }

    .closing-banner {
      align-items: start;
      flex-direction: column;
      gap: 20px;
      padding: 24px;
    }

    .site-footer {
      align-items: start;
      flex-direction: column;
      padding: 24px 18px;
      gap: 10px;
    }

    .site-footer p {
      margin: 0;
    }
  }

  @media (max-width: 360px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .news-card {
      min-height: 180px;
    }

    h1 {
      font-size: 36px;
    }
  }
</style>
