---
const sections = [
  { name: "South Africa", url: "/south-africa/", number: "01", label: "SA NEWS", description: "The stories shaping our nation." },
  { name: "World", url: "/world/", number: "02", label: "GLOBAL", description: "Important developments from around the world." },
  { name: "Politics", url: "/politics/", number: "03", label: "POLITICS", description: "Elections, parliament, government and policy." },
  { name: "Markets & Forex", url: "/markets-forex/", number: "04", label: "MARKETS", description: "Currencies, financial markets and money." },
  { name: "Sport", url: "/sport/", number: "05", label: "SPORT", description: "Teams, results and sporting highlights." },
  { name: "Technology", url: "/technology/", number: "06", label: "TECH", description: "New ideas, innovation and digital trends." },
  { name: "Jobs", url: "/jobs/", number: "07", label: "JOBS", description: "Where companies and government are hiring in SA." },
  { name: "Weather", url: "/weather/", number: "08", label: "WEATHER", description: "Weather for every town and city in South Africa." },
  { name: "Economic Calendar", url: "/economic-calendar/", number: "09", label: "ECONOMY", description: "Economic events and indicators to watch." }
];
---

<html lang="en">
  <head>
    <meta name="google-site-verification" content="2RbFof9a2eHgd0C4XOU6Kyw9db23duJCzGwVj6WTzQU" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SA News Hub: South African news, world headlines, politics, markets, forex, sport, technology, jobs, weather and economic events." />
    <meta name="theme-color" content="#101a2d" />
    <title>SA News Hub | News that matters</title>
  </head>

  <body data-page-theme="home">
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">SA NEWS <span>HUB.</span></a>
        <p class="tagline">NEWS THAT MATTERS. MARKETS THAT MOVE.</p>
        <nav aria-label="Main navigation">
          {sections.map((section) => (<a href={section.url}>{section.name}</a>))}
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="top-stories design6-hero">
        <div class="d6-hero-wrap">
          <div class="d6-hero-image">
            <img src="https://images.unsplash.com/photo-1529107386315-7dcc0a56f13b?w=1200&q=80" alt="South African community" />
          </div>
          <div class="d6-hero-text">
            <p class="eyebrow"><span class="status-dot"></span> YOUR DAILY BRIEFING</p>
            <h1>News and Jobs That Change Lives</h1>
            <p class="d6-hero-sub">Your trusted source for the latest South African news and career opportunities - empowering communities, creating futures.</p>
            <div class="d6-hero-btns">
              <a href="#sections" class="d6-btn-gold">Read News</a>
              <a href="/jobs/" class="d6-btn-outline">Find Jobs</a>
            </div>
          </div>
        </div>
        <div class="hero-small-wrap d6-quick">
          <a class="hero-small" href="/markets-forex/">
            <img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=400&q=80" alt="Markets" />
            <div><span class="hero-tag small">MARKETS</span><h3>Rand steady as markets await SARB decision</h3></div>
          </a>
          <a class="hero-small" href="/sport/">
            <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=400&q=80" alt="Sport" />
            <div><span class="hero-tag small">SPORT</span><h3>Boks name squad ahead of big weekend clash</h3></div>
          </a>
          <a class="hero-small" href="/jobs/">
            <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=400&q=80" alt="Jobs" />
            <div><span class="hero-tag small">JOBS</span><h3>Where is hiring right now in South Africa?</h3></div>
          </a>
        </div>
      </section>

      <section class="d6-stats" aria-label="Site statistics">
        <div><strong>12k+</strong><span>News Articles</span><small>Published &amp; fact-checked</small></div>
        <div><strong>3500+</strong><span>Jobs Posted</span><small>Across all provinces</small></div>
        <div><strong>50k+</strong><span>Community Members</span><small>And growing daily</small></div>
        <div><strong>9</strong><span>Provinces Covered</span><small>Nationwide coverage</small></div>
      </section>

      <section class="section-heading" id="sections">
        <div><p class="eyebrow">THE NEWSROOM</p><h2>Latest News</h2></div>
        <p class="section-description">Stay connected to the stories shaping your day. Choose a category below.</p>
      </section>

      <section class="news-grid" aria-label="News categories">
        {sections.map((section) => (
          <a class="news-card" href={section.url}>
            <div class="card-header"><span class="card-number">{section.number}</span><span class="card-label">{section.label}</span></div>
            <div class="card-content"><h3>{section.name}</h3><p>{section.description}</p></div>
            <div class="card-footer"><span>Explore section</span><span class="arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </section>

      <section class="section-heading">
        <div><p class="eyebrow">MONEY</p><h2>Markets & Forex</h2></div>
        <a class="section-link" href="/markets-forex/">View all markets →</a>
      </section>
      <section class="mini-grid">
        <div class="mini-card"><strong>USD / ZAR</strong><p id="usdZar">Loading...</p><small>US Dollar to Rand</small></div>
        <div class="mini-card"><strong>EUR / ZAR</strong><p id="eurZar">Loading...</p><small>Euro to Rand</small></div>
        <div class="mini-card"><strong>GBP / ZAR</strong><p id="gbpZar">Loading...</p><small>Pound to Rand</small></div>
        <div class="mini-card"><strong>Gold</strong><p>Live in Markets section</p><small>Spot price</small></div>
      </section>

      <section class="section-heading">
        <div><p class="eyebrow">ECONOMY</p><h2>Economic Calendar</h2></div>
        <a class="section-link" href="/economic-calendar/">Full calendar →</a>
      </section>
      <section class="list-box">
        <div class="list-row"><span>Thu, 20 Nov</span><strong>SARB Interest Rate Decision</strong><span class="pill">High Impact</span></div>
        <div class="list-row"><span>Wed, 19 Nov</span><strong>SA CPI Inflation Data</strong><span class="pill">High Impact</span></div>
        <div class="list-row"><span>Tue, 18 Nov</span><strong>US Fed Minutes</strong><span class="pill">Medium</span></div>
      </section>

      <section class="section-heading">
        <div><p class="eyebrow">INNOVATION</p><h2>Technology</h2></div>
        <a class="section-link" href="/technology/">More tech →</a>
      </section>
      <section class="news-grid">
        <a class="news-card" href="/technology/"><div class="card-content"><h3>AI is changing how SA businesses work</h3><p>Local companies adopt AI tools faster than ever.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
        <a class="news-card" href="/technology/"><div class="card-content"><h3>Starlink expands in Southern Africa</h3><p>Internet access grows in rural areas.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
        <a class="news-card" href="/technology/"><div class="card-content"><h3>Load shedding apps get smarter</h3><p>New features help households plan ahead.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
      </section>

      <section class="section-heading">
        <div><p class="eyebrow">SPORT</p><h2>Sport</h2></div>
        <a class="section-link" href="/sport/">More sport →</a>
      </section>
      <section class="news-grid">
        <a class="news-card" href="/sport/"><div class="card-content"><h3>Springboks: What to expect this weekend</h3><p>Team news, kick-off time and where to watch.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
        <a class="news-card" href="/sport/"><div class="card-content"><h3>Proteas build momentum ahead of series</h3><p>Key players return to form.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
        <a class="news-card" href="/sport/"><div class="card-content"><h3>PSL: Weekend fixtures and predictions</h3><p>All the big games in one place.</p></div><div class="card-footer"><span>Read story</span><span>↗</span></div></a>
      </section>

      <section class="section-heading">
        <div><p class="eyebrow">OPPORTUNITIES</p><h2>SA Jobs - Who Is Hiring?</h2></div>
        <a class="section-link" href="/jobs/">All jobs →</a>
      </section>
      <section class="filter-box">
        <input id="homeJobSearch" type="text" placeholder="Search jobs, e.g. SAPS, Durban, Cashier..." />
        <select id="homeJobLocation">
          <option value="">All Locations</option>
          <option value="Gauteng">Gauteng</option>
          <option value="Western Cape">Western Cape</option>
          <option value="KwaZulu-Natal">KwaZulu-Natal</option>
          <option value="Eastern Cape">Eastern Cape</option>
          <option value="Nationwide">Nationwide</option>
        </select>
      </section>
      <div id="homeJobList" class="mini-grid"></div>
      <p id="homeNoJobs" style="display:none;">No jobs found. Try another town or keyword.</p>

      <section class="section-heading">
        <div><p class="eyebrow">WEATHER</p><h2>Weather for SA</h2></div>
        <a class="section-link" href="/weather/">Full weather →</a>
      </section>
      <section class="filter-box">
        <input id="homeCitySearch" type="text" placeholder="Search town, e.g. Gqeberha, Polokwane, Soweto..." />
        <button id="homeWeatherBtn" class="search-btn">Search</button>
      </section>
      <div id="homeWeatherResult" class="weather-result">Loading Johannesburg weather...</div>
      <div id="homeWeatherGrid" class="mini-grid" style="margin-top:14px;"></div>

      <section class="section-heading">
        <div><p class="eyebrow">COMMUNITY</p><h2>What Our Community Says</h2></div>
      </section>
      <p class="d6-testi-sub">Real stories from people across South Africa</p>
      <section class="d6-testi-grid">
        <div class="d6-testi"><span>⭐⭐⭐⭐⭐</span><p>"SA News Hubs helped me find a teaching job close to home. The process was simple and genuine."</p><small>Teacher, Johannesburg</small></div>
        <div class="d6-testi"><span>⭐⭐⭐⭐⭐</span><p>"I rely on SA News Hubs for reliable local news. It keeps me connected to what's happening in my province."</p><small>Community Member, joined Jan 2024</small></div>
        <div class="d6-testi"><span>⭐⭐⭐⭐⭐</span><p>"The jobs section is updated daily and the roles are real. Landed my new role in just two weeks!"</p><small>Solar Technician, Cape Town</small></div>
      </section>

      <section class="closing-banner">
        <div><p class="eyebrow">STAY INFORMED</p><h2>Good information<br />changes perspective.</h2></div>
        <a class="closing-link" href="#sections">Discover our sections <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="footer-brand" href="/">SA NEWS <span>HUB.</span></a>
      <p>Independent news project · © 2026 SA News Hub</p>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy Policy</a>
      </div>
      <a class="footer-top" href="#">Back to top ↑</a>
    </footer>

    <script>
      fetch("https://api.frankfurter.app/latest?from=ZAR&to=USD,EUR,GBP").then(r=>r.json()).then(d=>{
        const usd = 1 / d.rates.USD; const eur = 1 / d.rates.EUR; const gbp = 1 / d.rates.GBP;
        const usdEl = document.getElementById("usdZar"); if(usdEl) usdEl.textContent = "R " + usd.toFixed(2);
        const eurEl = document.getElementById("eurZar"); if(eurEl) eurEl.textContent = "R " + eur.toFixed(2);
        const gbpEl = document.getElementById("gbpZar"); if(gbpEl) gbpEl.textContent = "R " + gbp.toFixed(2);
      }).catch(()=>{});
      const homeJobs = [
        { title: "SAPS Police Trainees - 5,500 Posts", company: "SAPS", location: "Nationwide", province: "Nationwide", closing: "30 Nov 2026" },
        { title: "Cashiers - Checkers", company: "Shoprite Group", location: "Gqeberha", province: "Eastern Cape", closing: "15 Nov 2026" },
        { title: "Transnet Apprenticeship", company: "Transnet", location: "Durban", province: "KwaZulu-Natal", closing: "20 Nov 2026" },
        { title: "Data Capturer - City of Cape Town", company: "City of Cape Town", location: "Cape Town", province: "Western Cape", closing: "12 Nov 2026" },
      ];
      function renderHomeJobs(){
        const q = (document.getElementById("homeJobSearch")?.value || "").toLowerCase();
        const loc = document.getElementById("homeJobLocation")?.value || "";
        const filtered = homeJobs.filter(j=>{
          const mSearch = (j.title+" "+j.company+" "+j.location).toLowerCase().includes(q);
          const mLoc =!loc || j.province===loc || j.province==="Nationwide";
          return mSearch && mLoc;
        });
        const list = document.getElementById("homeJobList");
        const noEl = document.getElementById("homeNoJobs");
        if(noEl) noEl.style.display = filtered.length===0? "block" : "none";
        if(list) list.innerHTML = filtered.map(j=>`<div class="mini-card"><strong>${j.title}</strong><p>${j.company} - ${j.location}</p><small>Closing: ${j.closing}</small><br><a href="/jobs/" style="font-weight:800; color:#176447;">View & Apply →</a></div>`).join("");
      }
      document.getElementById("homeJobSearch")?.addEventListener("input", renderHomeJobs);
      document.getElementById("homeJobLocation")?.addEventListener("change", renderHomeJobs);
      renderHomeJobs();
      const homeCities = [
        { name: "Johannesburg", lat: -26.2041, lon: 28.0473 },
        { name: "Cape Town", lat: -33.9249, lon: 18.4241 },
        { name: "Durban", lat: -29.8587, lon: 31.0218 },
        { name: "Gqeberha", lat: -33.9608, lon: 25.6022 },
      ];
      function wText(code){ if(code===0) return "Clear Sky ☀️"; if(code<=3) return "Partly Cloudy ⛅"; if(code<=48) return "Foggy 🌫️"; if(code<=67) return "Rain 🌧️"; if(code<=82) return "Showers 🌦️"; return "Thunderstorm ⛈️"; }
      async function loadHomeWeather(name, lat, lon){
        try{
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,wind_speed_10m&timezone=Africa/Johannesburg`);
          const d = await res.json();
          const el = document.getElementById("homeWeatherResult");
          if(el) el.innerHTML = `<strong>${name}</strong> - <span style="font-size:28px;">${Math.round(d.current.temperature_2m)}°C</span> ${wText(d.current.weather_code)} | Wind ${d.current.wind_speed_10m} km/h`;
        }catch(e){}
      }
      async function loadHomeGrid(){
        const grid = document.getElementById("homeWeatherGrid"); if(!grid) return;
        for(const c of homeCities){
          try{
            const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&current=temperature_2m,weather_code&timezone=Africa/Johannesburg`);
            const d = await res.json();
            const div = document.createElement("div"); div.className="mini-card"; div.style.cursor="pointer";
            div.innerHTML = `<strong>${c.name}</strong><p>${Math.round(d.current.temperature_2m)}°C</p><small>${wText(d.current.weather_code)}</small>`;
            div.onclick = ()=> loadHomeWeather(c.name, c.lat, c.lon);
            grid.appendChild(div);
          }catch(e){}
        }
      }
      async function searchHomeCity(){
        const val = document.getElementById("homeCitySearch")?.value; if(!val) return;
        const geo = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(val)}&count=1&countryCode=ZA&language=en&format=json`);
        const g = await geo.json();
        if(g.results && g.results.length>0){ const r=g.results[0]; loadHomeWeather(r.name, r.latitude, r.longitude); }
        else { const el=document.getElementById("homeWeatherResult"); if(el) el.textContent="Town not found. Try another spelling."; }
      }
      document.getElementById("homeWeatherBtn")?.addEventListener("click", searchHomeCity);
      document.getElementById("homeCitySearch")?.addEventListener("keydown", e=>{ if(e.key==="Enter") searchHomeCity(); });
      loadHomeWeather("Johannesburg", -26.2041, 28.0473);
      loadHomeGrid();
    </script>
  </body>
</html>

<style>
    * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: #f3f5f9; color: #172238; font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
  a { -webkit-tap-highlight-color: transparent; }
  .site-header { background: #101a2d; color: #fff; }
  .header-inner { max-width: 1160px; margin: 0 auto; padding: 24px 24px 0; }
  .brand,.footer-brand { display: inline-block; color: #fff; font-size: 25px; font-weight: 900; letter-spacing: 1px; text-decoration: none; }
  .brand span,.footer-brand span { color: #ffc66d; }
  .tagline { margin: 8px 0 23px; color: #aebbd0; font-size: 10px; letter-spacing: 2px; line-height: 1.6; }
  nav { display: flex; flex-wrap: wrap; gap: 0 23px; border-top: 1px solid #ffffff20; }
  nav a { padding: 16px 0; color: #dce4f0; font-size: 12px; text-decoration: none; }
  nav a:hover { color: #ffc66d; }
  main { max-width: 1160px; margin: 0 auto; padding: 30px 24px 55px; }
  .eyebrow { margin: 0 0 13px; color: #a66a13; font-size: 10px; font-weight: 800; letter-spacing: 2px; }
  .status-dot { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #ffc66d; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
  h2 { margin: 0; font-size: clamp(25px, 4vw, 34px); letter-spacing: -1px; }
  .top-stories { margin-bottom: 10px; }
  .hero-tag { display: inline-block; padding: 6px 10px; border-radius: 4px; background: #ffc66d; color: #172238; font-size: 10px; font-weight: 900; letter-spacing: 1px; margin-bottom: 10px; }
  .hero-tag.small { padding: 4px 7px; font-size: 9px; margin-bottom: 6px; }
  .hero-small-wrap { display: flex; flex-direction: column; gap: 16px; padding: 16px; }
  .hero-small { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid #e1e6ef; border-radius: 8px; padding: 12px; text-decoration: none; color: #172238; flex: 1; }
  .hero-small img { width: 110px; height: 90px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .hero-small h3 { margin: 0; font-size: 16px; line-height: 1.3; }
  .design6-hero { background: #fff; border: 1px solid #e1e6ef; border-radius: 12px; overflow: hidden; padding: 0; }
  .d6-hero-wrap { display: grid; grid-template-columns: 1fr 1fr; }
  .d6-hero-image img {
