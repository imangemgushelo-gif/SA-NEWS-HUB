---
import "../styles/page-themes.css";
const sections = [
  { name: "Weather", url: "/weather/", number: "01", label: "WEATHER", description: "Weather updates across South Africa." },
  { name: "Jobs", url: "/jobs/", number: "02", label: "JOBS", description: "Explore job opportunities across the country." },
  { name: "Politics", url: "/politics/", number: "03", label: "POLITICS", description: "Government, parliament and public policy." },
  { name: "Technology", url: "/technology/", number: "04", label: "TECHNOLOGY", description: "Digital news, science and innovation." },
  { name: "World", url: "/world/", number: "05", label: "WORLD", description: "Major developments from around the globe." },
  { name: "Sport", url: "/sport/", number: "06", label: "SPORT", description: "South African and international sport." },
  { name: "Economic Calendar", url: "/economic-calendar/", number: "07", label: "ECONOMIC CALENDAR", description: "Upcoming economic announcements and data." },
  { name: "Market & Forex", url: "/markets-forex/", number: "08", label: "MARKET & FOREX", description: "Market movements and currency exchange rates." }
];
---

<html lang="en">
<head>
  <meta name="google-site-verification" content="2RbFof9a2eHgd0C4XOU6Kyw9db23duJCzGwVj6WTzQU" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="SA News Hub: South African news, world headlines, politics, markets, forex, sport, technology, jobs, weather and economic events." />
  <meta name="theme-color" content="#101a2d" />
  <title>SA News Hub | News that matters</title>
</head>
<body data-page-theme="home">
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="SA News Hubs home">SA News Hubs</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open navigation">☰</button>
    <nav id="main-nav" aria-label="Main navigation">
      <a class="active" href="/">Home</a>
      <a href="#sections">News</a>
      <a href="/jobs/">Jobs</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a class="account-link" href="/about/" aria-label="Account">♙</a>
    </nav>
  </div>
</header>

<main class="home-main">
  <section class="design6-hero"><div class="d6-hero-wrap"><div class="d6-hero-text">
    <h1>News and Jobs That Change Lives</h1>
    <p class="d6-hero-sub">Your trusted source for the latest South African news and career opportunities—empowering communities, creating futures.</p>
    <div class="d6-hero-btns"><a href="#latestNews" class="d6-btn-gold">▤ &nbsp; Read News</a><a href="/jobs/" class="d6-btn-outline">▣ &nbsp; Find Jobs</a></div>
  </div></div></section>
  <div class="home-content">
    <a class="breaking-strip" href="/south-africa/"><strong>♨ &nbsp; BREAKING NEWS</strong><span>Latest South African headlines and updates</span><b>›</b></a>
    <nav class="category-tiles" aria-label="News categories">
      <a href="/weather/"><span>🌦️</span><b>Weather</b></a><a href="/jobs/"><span>💼</span><b>Jobs</b></a><a href="/politics/"><span>🏛️</span><b>Politics</b></a><a href="/technology/"><span>🌐</span><b>Technology</b></a><a href="/world/"><span>🌍</span><b>World</b></a><a href="/sport/"><span>⚽</span><b>Sport</b></a><a href="/economic-calendar/"><span>🗓️</span><b>Economic Calendar</b></a><a href="/markets-forex/"><span>📈</span><b>Market &amp; Forex</b></a>
    </nav>
    <a class="featured-story" href="/south-africa/"><img src="https://images.unsplash.com/photo-1576485290814-1c72aa4bbb8e?auto=format&fit=crop&w=1000&q=85" alt="Cape Town and Table Mountain" loading="lazy"><div class="featured-copy"><span class="featured-label">FEATURED STORY</span><h2>South Africa: the stories shaping our future</h2><p>Catch up on major developments, public issues and opportunities affecting people across the country.</p><span class="read-more">Read More →</span></div></a>
    <section id="latestNews" class="home-section"><div class="home-section-title"><h2>▤ &nbsp; Latest News</h2><a href="/south-africa/">View All News →</a></div><div id="latestNewsGrid" class="latest-news-grid" aria-live="polite"><p class="news-loading">Loading the latest headlines…</p></div></section>
    <section class="home-section"><div class="home-section-title"><h2>▣ &nbsp; Latest Jobs</h2><a href="/jobs/">View All Jobs →</a></div><div class="filter-box"><input id="homeJobSearch" type="text" placeholder="Search jobs, e.g. administrator, East London..." /><button id="homeJobBtn" class="search-btn">Search</button></div><p id="homeJobStatus" class="home-job-status">Loading live jobs...</p><div id="homeJobList" class="mini-grid home-jobs-list"></div><p id="homeNoJobs" style="display:none;">No live jobs found.</p></section>
    <section class="home-section"><div class="home-section-title"><h2>📈 &nbsp; Business &amp; Economy</h2><a href="/markets-forex/">Read More →</a></div><a class="economy-feature" href="/markets-forex/"><img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=700&q=80" alt="Financial market charts" loading="lazy"><div><h3>Markets, money and the South African economy</h3><p>Stay informed about financial markets, exchange rates and economic developments impacting South Africans.</p><span class="read-more">Explore Markets &amp; Forex →</span></div><span class="economy-arrow">View</span></a></section>
    <section class="home-section useful-section"><div class="home-section-title"><h2>♧ &nbsp; Useful Information</h2></div><div class="useful-grid"><button class="weather-summary" type="button" onclick="document.getElementById('homeWeatherResult')?.scrollIntoView({behavior:'smooth',block:'center'})"><span>🌤️</span><div><b>East London</b><p id="weatherSummaryText">Weather update loading…</p></div></button><div class="useful-links"><a href="/weather/">🌦️ &nbsp; Weather Update <b>›</b></a><a href="/south-africa/">🏛️ &nbsp; Public Service News <b>›</b></a><a href="/economic-calendar/">◷ &nbsp; Economic Calendar <b>›</b></a></div></div><div class="weather-detail" id="homeWeatherResult">Loading East London weather...</div><div id="homeWeatherGrid" class="mini-grid-2" style="margin-top:10px;"></div><div class="market-mini"><b>Markets &amp; Forex</b><span>USD/ZAR <strong id="usdZar">Loading…</strong></span><span>EUR/ZAR <strong id="eurZar">Loading…</strong></span><span>GBP/ZAR <strong id="gbpZar">Loading…</strong></span></div></section>
    <section class="newsletter-box"><div><h2>✉ &nbsp; Get the Latest News Updates</h2><p>Stay informed with the latest stories and important updates.</p></div><form id="newsletterForm"><input type="email" placeholder="Enter your email address" aria-label="Email address" required><button type="submit">Subscribe</button></form><p id="newsletterStatus" class="newsletter-status" aria-live="polite"></p></section>
  </div>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-about">
      <a class="footer-brand" href="/">SA News Hubs</a>
      <p>Delivering trusted news and meaningful job opportunities to communities across South Africa.</p>
    </div>
    <div class="footer-column">
      <h2>Quick Links</h2>
      <a href="#sections">News</a><a href="/jobs/">Jobs</a><a href="/about/">About</a><a href="/contact/">Contact</a>
    </div>
    <div class="footer-column">
      <h2>Contact</h2>
      <a href="mailto:hello@sanewshubs.co.za">✉ hello@sanewshubs.co.za</a>
      <span>⌖ East London, Eastern Cape, South Africa</span>
    </div>
  </div>
  <div class="footer-bottom"><span>© 2026 SA News Hubs. All rights reserved.</span><span><a href="/privacy-policy/">Privacy Policy</a></span><a class="footer-top" href="#">Back to top ↑</a></div>
</footer>

<nav class="mobile-bottom-nav" aria-label="Quick navigation">
  <a href="/" aria-current="page"><span>🏠</span><b>Home</b></a>
  <a href="/news/"><span>📰</span><b>News</b></a>
  <a href="/jobs/"><span>💼</span><b>Jobs</b></a>
  <a href="/about/"><span>👤</span><b>About</b></a>
</nav>

<script>
  document.querySelector(".menu-toggle")?.addEventListener("click", (event) => {
    const button = event.currentTarget;
    const nav = document.getElementById("main-nav");
    const open = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    nav?.classList.toggle("is-open", open);
  });

  const APP_ID = "897de7b4";
  const APP_KEY = "8625a7661b6f67374d01e3fedb62fefb";

  fetch("https://api.frankfurter.app/latest?from=ZAR&to=USD,EUR,GBP").then(r=>r.json()).then(d=>{
    const usdEl=document.getElementById("usdZar"); if(usdEl) usdEl.textContent="R "+(1/d.rates.USD).toFixed(2);
    const eurEl=document.getElementById("eurZar"); if(eurEl) eurEl.textContent="R "+(1/d.rates.EUR).toFixed(2);
    const gbpEl=document.getElementById("gbpZar"); if(gbpEl) gbpEl.textContent="R "+(1/d.rates.GBP).toFixed(2);
  }).catch(()=>{});

  async function fetchNews(query, limit){
    const res = await fetch("https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(`https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=en-ZA&gl=ZA&ceid=ZA:en`));
    const data = await res.json();
    return (data.items || []).slice(0, limit);
  }
  fetchNews("South Africa", 6).then(items=>{
    const grid=document.getElementById("latestNewsGrid");
    if(!grid) return;
    if(!items.length){ grid.innerHTML='<p class="news-loading">Headlines are temporarily unavailable. Please try again shortly.</p>'; return; }
    grid.innerHTML=items.map((n,i)=>`<article class="latest-news-card ${i===0?'featured-news-card':''}">
      <a class="latest-news-image" href="${n.link}" target="_blank" rel="noopener" aria-label="Read ${n.title}">
        <img loading="lazy" src="${n.thumbnail || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=900&q=80'}" alt="" />
        <span class="news-pill">${i===0?'TOP STORY':'LATEST'}</span>
      </a>
      <div class="latest-news-copy"><p class="eyebrow">SOUTH AFRICA</p><h3><a href="${n.link}" target="_blank" rel="noopener">${n.title}</a></h3><a class="read-story-link" href="${n.link}" target="_blank" rel="noopener">Read full story ↗</a></div>
    </article>`).join("");
  }).catch(()=>{
    const grid=document.getElementById("latestNewsGrid");
    if(grid) grid.innerHTML='<p class="news-loading">Headlines are temporarily unavailable. Please try again shortly.</p>';
  });

  async function renderHomeJobs(){
    const q=document.getElementById("homeJobSearch")?.value||"";
    const list=document.getElementById("homeJobList");
    const status=document.getElementById("homeJobStatus");
    const noEl=document.getElementById("homeNoJobs");
    status.textContent="Loading live jobs..."; list.innerHTML="";
    try{
      const res=await fetch(`https://api.adzuna.com/v1/api/jobs/za/search/1?app_id=${APP_ID}&app_key=${APP_KEY}&results_per_page=4&what=${encodeURIComponent(q)}&sort_by=date`);
      const data=await res.json();
      if(!data.results||data.results.length===0){ status.textContent=""; noEl.style.display="block"; return; }
      status.textContent=""; noEl.style.display="none";
      list.innerHTML=data.results.map(j=>`<div class="mini-card"><strong>${j.title}</strong><p>${j.company?.display_name||""} - ${j.location?.display_name||"South Africa"}</p><small>${j.created? new Date(j.created).toLocaleDateString("en-ZA"):""}</small><br><a href="${j.redirect_url}" target="_blank" rel="noopener" style="font-weight:800;color:#176447;">Apply →</a></div>`).join("");
    }catch(e){ status.textContent="Could not load live jobs."; }
  }
  document.getElementById("homeJobBtn")?.addEventListener("click", renderHomeJobs);
  document.getElementById("homeJobSearch")?.addEventListener("keydown", e=>{ if(e.key==="Enter") renderHomeJobs(); });
  renderHomeJobs();

  function wText(code){ if(code===0) return "Clear Sky ☀️"; if(code<=3) return "Partly Cloudy ⛅"; if(code<=48) return "Foggy 🌫️"; if(code<=67) return "Rain 🌧️"; if(code<=82) return "Showers 🌦️"; return "Thunderstorm ⛈️"; }
  async function loadHomeWeather(name, lat, lon){
    try{
      const res=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,wind_speed_10m&timezone=Africa/Johannesburg`);
      const d=await res.json();
      document.getElementById("homeWeatherResult").innerHTML=`<strong>${name}</strong> - <span style="font-size:22px;">${Math.round(d.current.temperature_2m)}°C</span> ${wText(d.current.weather_code)} | Wind ${d.current.wind_speed_10m} km/h`; const summary=document.getElementById("weatherSummaryText"); if(summary) summary.textContent=`${Math.round(d.current.temperature_2m)}°C | ${wText(d.current.weather_code)}`;
    }catch(e){}
  }
  async function loadHomeGrid(){
    const grid=document.getElementById("homeWeatherGrid"); if(!grid) return;
    const cities=[{name:"East London",lat:-33.0153,lon:27.9116},{name:"Johannesburg",lat:-26.2041,lon:28.0473},{name:"Cape Town",lat:-33.9249,lon:18.4241},{name:"Durban",lat:-29.8587,lon:31.0218},{name:"Gqeberha",lat:-33.9608,lon:25.6022}];
    for(const c of cities){
      try{
        const res=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&current=temperature_2m,weather_code&timezone=Africa/Johannesburg`);
        const d=await res.json();
        const div=document.createElement("div"); div.className="mini-card"; div.style.cursor="pointer";
        div.innerHTML=`<strong>${c.name}</strong><p>${Math.round(d.current.temperature_2m)}°C</p><small>${wText(d.current.weather_code)}</small>`;
        div.onclick=()=>loadHomeWeather(c.name,c.lat,c.lon);
        grid.appendChild(div);
      }catch(e){}
    }
  }
  loadHomeWeather("East London",-33.0153,27.9116);
  loadHomeGrid();
  document.getElementById("newsletterForm")?.addEventListener("submit",e=>{e.preventDefault();document.getElementById("newsletterStatus").textContent="Newsletter sign-up is not connected yet.";});
</script>
</body>
</html>

<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#f5f7fb;color:#102542;font-family:Arial,Helvetica,sans-serif}
.site-header{position:relative;z-index:5;background:#052344;color:#fff;border-bottom:1px solid #ffffff22}.header-inner{max-width:1180px;min-height:62px;margin:auto;padding:10px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand,.footer-brand{color:#fff;font-size:clamp(22px,2.5vw,31px);font-weight:900;letter-spacing:-.6px;text-decoration:none;white-space:nowrap}.brand-mark{display:none}nav#main-nav{display:flex;align-items:center;gap:clamp(12px,2vw,26px)}nav#main-nav a{padding:10px 0;color:#f2f5fa;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap}nav#main-nav a:hover,nav#main-nav a.active{color:#ffc54d}nav#main-nav .account-link{font-size:22px}.menu-toggle{display:none;background:transparent;border:1px solid #ffffff60;border-radius:6px;color:#fff;padding:7px 10px;font-size:20px}
.home-main{padding:0 0 28px}.design6-hero{overflow:hidden;background:#052344}.d6-hero-wrap{position:relative;display:flex;align-items:center;min-height:330px;padding:36px max(22px,calc((100% - 1120px)/2));background:linear-gradient(90deg,rgba(3,27,54,.96) 0%,rgba(3,27,54,.78) 45%,rgba(3,27,54,.12) 100%),url("https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=1800&q=85") center 48%/cover no-repeat}.d6-hero-text{position:relative;z-index:1;max-width:590px;color:white}.d6-hero-text h1{max-width:540px;margin:0;color:#fff;font-size:clamp(34px,4vw,49px);font-weight:900;letter-spacing:-1px;line-height:1.06}.d6-hero-sub{max-width:510px;margin:12px 0 0;color:#f2f5fa;font-size:16px;line-height:1.4}.d6-hero-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:17px}.d6-btn-gold,.d6-btn-outline{display:inline-flex;justify-content:center;align-items:center;gap:8px;min-width:145px;padding:11px 16px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:800}.d6-btn-gold{background:#ffc51d;color:#062243;border:2px solid #ffc51d}.d6-btn-outline{background:#05234488;color:#fff;border:2px solid #fff}
.home-content{max-width:1000px;margin:0 auto;padding:0 16px}.breaking-strip{display:flex;align-items:center;gap:14px;margin:12px 0;background:#fff0f0;border-radius:6px;overflow:hidden;color:#142747;text-decoration:none;min-height:42px}.breaking-strip strong{display:block;align-self:stretch;padding:13px 14px;background:#df2432;color:#fff;font-size:12px;white-space:nowrap}.breaking-strip span{font-size:13px;font-weight:700;flex:1}.breaking-strip>b{padding:0 14px;font-size:24px;color:#34516f}.category-tiles{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:8px;margin:12px 0}.category-tiles a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:76px;padding:10px 5px;background:#edf3fb;border-radius:8px;color:#102542;text-decoration:none;text-align:center}.category-tiles a span{font-size:23px}.category-tiles a b{font-size:12px;line-height:1.2}.category-tiles a:hover{background:#dfeafa}.featured-story{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:center;margin:12px 0 20px;padding:10px;background:#edf4fc;border-radius:8px;text-decoration:none;color:#102542}.featured-story>img{width:100%;height:175px;object-fit:cover;border-radius:6px}.featured-copy{padding:8px 8px 8px 0}.featured-label{display:inline-block;padding:5px 8px;border-radius:4px;background:#ffd21f;color:#152b49;font-size:10px;font-weight:900}.featured-copy h2{margin:9px 0;font-size:21px;line-height:1.2}.featured-copy p{margin:0 0 10px;color:#4a5c73;font-size:13px;line-height:1.45}.read-more{color:#0755a3;font-size:13px;font-weight:800}.home-section{margin:20px 0}.home-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 2px 9px}.home-section-title h2{margin:0;font-size:19px;letter-spacing:-.3px}.home-section-title>a{color:#0755a3;text-decoration:none;font-size:12px;font-weight:800;white-space:nowrap}
