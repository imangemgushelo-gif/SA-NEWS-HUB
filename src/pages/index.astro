---
import "../styles/page-themes.css";
const sections = [
  { name: "South Africa", url: "/south-africa/", number: "01", label: "SA NEWS", description: "The stories shaping our nation." },
  { name: "World", url: "/world/", number: "02", label: "GLOBAL", description: "Important developments from around the world." },
  { name: "Politics", url: "/politics/", number: "03", label: "POLITICS", description: "Elections, parliament, government and policy." },
  { name: "Markets & Forex", url: "/markets-forex/", number: "04", label: "MARKETS", description: "Currencies, financial markets and money." },
  { name: "Sport", url: "/sport/", number: "05", label: "SPORT", description: "Teams, results and sporting highlights." },
  { name: "Technology", url: "/technology/", number: "06", label: "TECH", description: "New ideas, innovation and digital trends." },
  { name: "Jobs", url: "/jobs/", number: "07", label: "JOBS", description: "Where companies and government are hiring in SA." },
  { name: "Weather", url: "/weather/", number: "08", label: "WEATHER", description: "Weather for every town and city in South Africa." },
  { name: "Economic Calendar", url: "/economic-calendar/", number: "09", label: "ECONOMY", description: "Economic events and indicators to watch." }
];
---

<html lang="en">
<head>
  <meta name="google-site-verification" content="2RbFof9a2eHgd0C4XOU6Kyw9db23duJCzGwVj6WTzQU" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="SA News Hub: South African news, world headlines, politics, markets, forex, sport, technology, jobs, weather and economic events." />
  <meta name="theme-color" content="#101a2d" />
  <title>SA News Hub | News that matters</title>
</head>
<body data-page-theme="home">
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="SA News Hubs home"><span class="brand-mark" aria-hidden="true">📍</span> SA News Hubs</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open navigation">☰</button>
    <nav id="main-nav" aria-label="Main navigation">
      <a class="active" href="/">Home</a>
      <a href="#sections">News</a>
      <a href="/jobs/">Jobs</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a class="account-link" href="/about/" aria-label="Account">♙</a>
    </nav>
  </div>
</header>

<main>
  <!-- 1. HERO -->
  <section class="design6-hero">
    <div class="d6-hero-wrap">
      <div class="d6-hero-image" role="img" aria-label="South African community gathering"></div>
      <div class="d6-hero-text">
        <h1>News and Jobs That Change Lives</h1>
        <p class="d6-hero-sub">Your trusted source for the latest South African news and career opportunities—empowering communities, creating futures.</p>
        <div class="d6-hero-btns">
          <a href="#sections" class="d6-btn-gold"><span aria-hidden="true">▤</span> Read News</a>
          <a href="/jobs/" class="d6-btn-outline"><span aria-hidden="true">▣</span> Find Jobs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. LATEST NEWS -->
  <section class="section-heading" id="sections">
    <div><p class="eyebrow">THE NEWSROOM</p><h2>Latest News</h2></div>
    <a class="section-link" href="/south-africa/">All news →</a>
  </section>
  <section id="latestNewsGrid" class="latest-news-grid" aria-live="polite">
    <p class="news-loading">Loading the latest headlines…</p>
  </section>
  <section class="section-heading category-heading">
    <div><p class="eyebrow">EXPLORE THE NEWSROOM</p><h2>Browse by Category</h2></div>
  </section>
  <section class="news-grid">
    {sections.map((section) => (
      <a class="news-card" href={section.url}>
        <div class="card-header"><span class="card-number">{section.number}</span><span class="card-label">{section.label}</span></div>
        <div class="card-content"><h3>{section.name}</h3><p>{section.description}</p></div>
        <div class="card-footer"><span>Explore →</span><span>↗</span></div>
      </a>
    ))}
  </section>

  <!-- 3. JOBS - LIVE ONLY -->
  <section class="section-heading">
    <div><p class="eyebrow">OPPORTUNITIES</p><h2>SA Jobs - Who Is Hiring?</h2></div>
    <a class="section-link" href="/jobs/">All jobs →</a>
  </section>
  <section class="filter-box">
    <input id="homeJobSearch" type="text" placeholder="Search live jobs, e.g. Cashier, Durban..." />
    <button id="homeJobBtn" class="search-btn">Search Live Jobs</button>
  </section>
  <p id="homeJobStatus" style="color:#5a6a80;">Loading live jobs...</p>
  <div id="homeJobList" class="mini-grid"></div>
  <p id="homeNoJobs" style="display:none;">No live jobs found.</p>

  <!-- 4. MARKETS + WEATHER - ONE ROW -->
  <section class="split">
    <div>
      <section class="section-heading">
        <div><p class="eyebrow">MONEY</p><h2>Markets & Forex</h2></div>
        <a class="section-link" href="/markets-forex/">View all →</a>
      </section>
      <div class="stack">
        <div class="mini-card"><strong>USD / ZAR</strong><p id="usdZar">Loading...</p><small>US Dollar to Rand</small></div>
        <div class="mini-card"><strong>EUR / ZAR</strong><p id="eurZar">Loading...</p><small>Euro to Rand</small></div>
        <div class="mini-card"><strong>GBP / ZAR</strong><p id="gbpZar">Loading...</p><small>Pound to Rand</small></div>
      </div>
    </div>
    <div>
      <section class="section-heading">
        <div><p class="eyebrow">WEATHER</p><h2>Weather for SA</h2></div>
        <a class="section-link" href="/weather/">Full weather →</a>
      </section>
      <div id="homeWeatherResult" class="weather-result">Loading East London weather...</div>
      <div id="homeWeatherGrid" class="mini-grid-2" style="margin-top:14px;"></div>
    </div>
  </section>

  <section class="closing-banner">
    <div><p class="eyebrow">STAY INFORMED</p><h2>Good information<br />changes perspective.</h2></div>
    <a class="closing-link" href="#sections">Discover our sections <span>→</span></a>
  </section>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-about">
      <a class="footer-brand" href="/"><span class="brand-mark" aria-hidden="true">📍</span> SA News Hubs</a>
      <p>Delivering trusted news and meaningful job opportunities to communities across South Africa.</p>
    </div>
    <div class="footer-column">
      <h2>Quick Links</h2>
      <a href="#sections">News</a><a href="/jobs/">Jobs</a><a href="/about/">About</a><a href="/contact/">Contact</a>
    </div>
    <div class="footer-column">
      <h2>Contact</h2>
      <a href="mailto:hello@sanewshubs.co.za">✉ hello@sanewshubs.co.za</a>
      <a href="tel:+27214005000">☎ +27 21 400 5000</a>
      <span>⌖ East London, Eastern Cape, South Africa</span>
    </div>
  </div>
  <div class="footer-bottom"><span>© 2026 SA News Hubs. All rights reserved.</span><span><a href="/privacy-policy/">Privacy Policy</a></span><a class="footer-top" href="#">Back to top ↑</a></div>
</footer>

<script>
  document.querySelector(".menu-toggle")?.addEventListener("click", (event) => {
    const button = event.currentTarget;
    const nav = document.getElementById("main-nav");
    const open = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    nav?.classList.toggle("is-open", open);
  });

  const APP_ID = "897de7b4";
  const APP_KEY = "8625a7661b6f67374d01e3fedb62fefb";

  fetch("https://api.frankfurter.app/latest?from=ZAR&to=USD,EUR,GBP").then(r=>r.json()).then(d=>{
    const usdEl=document.getElementById("usdZar"); if(usdEl) usdEl.textContent="R "+(1/d.rates.USD).toFixed(2);
    const eurEl=document.getElementById("eurZar"); if(eurEl) eurEl.textContent="R "+(1/d.rates.EUR).toFixed(2);
    const gbpEl=document.getElementById("gbpZar"); if(gbpEl) gbpEl.textContent="R "+(1/d.rates.GBP).toFixed(2);
  }).catch(()=>{});

  async function fetchNews(query, limit){
    const res = await fetch("https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(`https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=en-ZA&gl=ZA&ceid=ZA:en`));
    const data = await res.json();
    return (data.items || []).slice(0, limit);
  }
  fetchNews("South Africa", 6).then(items=>{
    const grid=document.getElementById("latestNewsGrid");
    if(!grid) return;
    if(!items.length){ grid.innerHTML='<p class="news-loading">Headlines are temporarily unavailable. Please try again shortly.</p>'; return; }
    grid.innerHTML=items.map((n,i)=>`<article class="latest-news-card ${i===0?'featured-news-card':''}">
      <a class="latest-news-image" href="${n.link}" target="_blank" rel="noopener" aria-label="Read ${n.title}">
        <img loading="lazy" src="${n.thumbnail || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=900&q=80'}" alt="" />
        <span class="news-pill">${i===0?'TOP STORY':'LATEST'}</span>
      </a>
      <div class="latest-news-copy"><p class="eyebrow">SOUTH AFRICA</p><h3><a href="${n.link}" target="_blank" rel="noopener">${n.title}</a></h3><a class="read-story-link" href="${n.link}" target="_blank" rel="noopener">Read full story ↗</a></div>
    </article>`).join("");
  }).catch(()=>{
    const grid=document.getElementById("latestNewsGrid");
    if(grid) grid.innerHTML='<p class="news-loading">Headlines are temporarily unavailable. Please try again shortly.</p>';
  });

  async function renderHomeJobs(){
    const q=document.getElementById("homeJobSearch")?.value||"";
    const list=document.getElementById("homeJobList");
    const status=document.getElementById("homeJobStatus");
    const noEl=document.getElementById("homeNoJobs");
    status.textContent="Loading live jobs..."; list.innerHTML="";
    try{
      const res=await fetch(`https://api.adzuna.com/v1/api/jobs/za/search/1?app_id=${APP_ID}&app_key=${APP_KEY}&results_per_page=4&what=${encodeURIComponent(q)}&sort_by=date`);
      const data=await res.json();
      if(!data.results||data.results.length===0){ status.textContent=""; noEl.style.display="block"; return; }
      status.textContent=""; noEl.style.display="none";
      list.innerHTML=data.results.map(j=>`<div class="mini-card"><strong>${j.title}</strong><p>${j.company?.display_name||""} - ${j.location?.display_name||"South Africa"}</p><small>${j.created? new Date(j.created).toLocaleDateString("en-ZA"):""}</small><br><a href="${j.redirect_url}" target="_blank" rel="noopener" style="font-weight:800;color:#176447;">Apply →</a></div>`).join("");
    }catch(e){ status.textContent="Could not load live jobs."; }
  }
  document.getElementById("homeJobBtn")?.addEventListener("click", renderHomeJobs);
  document.getElementById("homeJobSearch")?.addEventListener("keydown", e=>{ if(e.key==="Enter") renderHomeJobs(); });
  renderHomeJobs();

  function wText(code){ if(code===0) return "Clear Sky ☀️"; if(code<=3) return "Partly Cloudy ⛅"; if(code<=48) return "Foggy 🌫️"; if(code<=67) return "Rain 🌧️"; if(code<=82) return "Showers 🌦️"; return "Thunderstorm ⛈️"; }
  async function loadHomeWeather(name, lat, lon){
    try{
      const res=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,wind_speed_10m&timezone=Africa/Johannesburg`);
      const d=await res.json();
      document.getElementById("homeWeatherResult").innerHTML=`<strong>${name}</strong> - <span style="font-size:28px;">${Math.round(d.current.temperature_2m)}°C</span> ${wText(d.current.weather_code)} | Wind ${d.current.wind_speed_10m} km/h`;
    }catch(e){}
  }
  async function loadHomeGrid(){
    const grid=document.getElementById("homeWeatherGrid"); if(!grid) return;
    const cities=[{name:"East London",lat:-33.0153,lon:27.9116},{name:"Johannesburg",lat:-26.2041,lon:28.0473},{name:"Cape Town",lat:-33.9249,lon:18.4241},{name:"Durban",lat:-29.8587,lon:31.0218},{name:"Gqeberha",lat:-33.9608,lon:25.6022}];
    for(const c of cities){
      try{
        const res=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&current=temperature_2m,weather_code&timezone=Africa/Johannesburg`);
        const d=await res.json();
        const div=document.createElement("div"); div.className="mini-card"; div.style.cursor="pointer";
        div.innerHTML=`<strong>${c.name}</strong><p>${Math.round(d.current.temperature_2m)}°C</p><small>${wText(d.current.weather_code)}</small>`;
        div.onclick=()=>loadHomeWeather(c.name,c.lat,c.lon);
        grid.appendChild(div);
      }catch(e){}
    }
  }
  loadHomeWeather("East London",-33.0153,27.9116);
  loadHomeGrid();
</script>
</body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f4f6f9; color: #172238; font-family: Arial, Helvetica, sans-serif; }
  .site-header { position: relative; z-index: 5; background: #071a35; color: #fff; border-bottom: 1px solid #ffffff20; }
  .header-inner { max-width: 1440px; min-height: 88px; margin: 0 auto; padding: 18px 5.8%; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .brand,.footer-brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: clamp(23px,3.2vw,42px); font-weight: 900; letter-spacing: -.7px; text-decoration: none; white-space: nowrap; }
  .brand-mark { color: #ffc54d; font-size: .9em; }
  nav { display: flex; align-items: center; gap: clamp(12px,2.1vw,32px); }
  nav a { position: relative; padding: 12px 0; color: #f2f5fa; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  nav a:hover, nav a.active { color: #ffc54d; }
  nav a.active::after { content: ""; position: absolute; bottom: 2px; left: 0; right: 0; height: 3px; background: #ffc54d; }
  nav a.account-link { font-size: 25px; }
  .menu-toggle { display: none; background: transparent; border: 1px solid #ffffff60; border-radius: 6px; color: #fff; padding: 8px 10px; font-size: 20px; }
  main { max-width: none; margin: 0 auto; padding: 0 0 55px; }
  .design6-hero { overflow: hidden; background: #071a35; border: 0; border-radius: 0; }
  .d6-hero-wrap { position: relative; display: flex; align-items: center; min-height: 490px; padding: 56px 6%; background: linear-gradient(90deg,rgba(4,22,46,.98) 0%,rgba(4,22,46,.88) 28%,rgba(4,22,46,.4) 53%,rgba(4,22,46,.04) 100%), url("https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2000&q=85") center 48%/cover no-repeat; }
  .d6-hero-image { display: none; }
  .d6-hero-text { position: relative; z-index: 1; max-width: 720px; padding: 0; display: flex; flex-direction: column; justify-content: center; color: #fff; }
  .d6-hero-text h1 { max-width: 690px; margin: 0; color: #fff; font-size: clamp(36px,4.2vw,58px); font-weight: 900; letter-spacing: -1.6px; line-height: 1.08; }
  .d6-hero-sub { max-width: 690px; margin: 20px 0 0; color: #f2f5fa; font-size: clamp(16px,1.6vw,21px); line-height: 1.5; }
  .d6-hero-btns { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 26px; }
  .d6-btn-gold,.d6-btn-outline { display: inline-flex; justify-content: center; align-items: center; gap: 12px; min-width: 220px; padding: 16px 22px; border-radius: 8px; text-decoration: none; font-size: 20px; font-weight: 800; }
  .d6-btn-gold { background: #ffc54d; color: #071a35; border: 2px solid #ffc54d; }
  .d6-btn-gold:hover { background: #ffd574; }
  .d6-btn-outline { background: rgba(7,26,53,.42); color: #fff; border: 2px solid #fff; }
  .d6-btn-outline:hover { background: rgba(255,255,255,.15); }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin: 44px auto 18px; max-width: 1240px; padding: 0 24px; }
  .latest-news-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; max-width: 1192px; margin: 0 auto; padding: 0 24px; }
  .latest-news-card { min-width: 0; overflow: hidden; background: #fff; border: 1px solid #e1e6ef; border-radius: 14px; box-shadow: 0 5px 18px #10213a0a; }
  .featured-news-card { grid-column: span 2; }
  .latest-news-image { position: relative; display: block; height: 190px; overflow: hidden; background: #dce3ec; }
  .featured-news-card .latest-news-image { height: 260px; }
  .latest-news-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .news-pill { position: absolute; top: 12px; left: 12px; padding: 6px 9px; border-radius: 5px; background: #ffc54d; color: #071a35; font-size: 10px; font-weight: 900; letter-spacing: 1px; }
  .latest-news-copy { padding: 18px; }
  .latest-news-copy .eyebrow { margin-bottom: 8px; }
  .latest-news-copy h3 { margin: 0 0 16px; font-size: 18px; line-height: 1.35; }
  .latest-news-copy h3 a { color: #14223a; text-decoration: none; }
  .latest-news-copy h3 a:hover { color: #a66a13; }
  .read-story-link,.section-link { color: #145b48; font-weight: 800; text-decoration: none; }
  .news-loading { grid-column: 1/-1; padding: 24px; background: #fff; border-radius: 12px; color: #53627a; }
  .eyebrow { margin: 0 0 13px; color: #a66a13; font-size: 10px; font-weight: 800; letter-spacing: 2px; }
  .status-dot { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #ffc66d; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
  h2 { margin: 0; font-size: clamp(25px, 4vw, 34px); letter-spacing: -1px; }
  .hero-tag { display: inline-block; padding: 6px 10px; border-radius: 4px; background: #ffc66d; color: #172238; font-size: 10px; font-weight: 900; letter-spacing: 1px; margin-bottom: 10px; }
  .hero-tag.small { padding: 4px 7px; font-size: 9px; margin-bottom: 6px; }
  .hero-small { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid #e1e6ef; border-radius: 8px; padding: 12px; text-decoration: none; color: #172238; flex: 1; }
  .hero-small img { width: 110px; height: 90px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .hero-small h3 { margin: 0; font-size: 16px; line-height: 1.3; }
  .section-link { color: #176447; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .news-grid,.filter-box,#homeJobStatus,#homeJobList,#homeNoJobs,.split,.closing-banner { max-width: 1240px; margin-left: auto; margin-right: auto; }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 0 24px; }
  .news-card { background: #fff; border: 1px solid #e1e6ef; border-radius: 10px; padding: 20px; text-decoration: none; color: #172238; display: flex; flex-direction: column; justify-content: space-between; }
  .card-header { display: flex; justify-content: space-between; }
  .card-number { font-weight: 900; color: #aebbd0; }
  .card-label { font-size: 10px; font-weight: 900; letter-spacing: 1px; background: #fff3d6; color: #a66a13; padding: 5px 8px; border-radius: 4px; }
  .card-content h3 { margin: 14px 0 8px; font-size: 18px; }
  .card-content p { color: #5a6a80; font-size: 14px; line-height: 1.5; margin: 0; }
  .card-footer { display: flex; justify-content: space-between; margin-top: 16px; font-size: 13px; font-weight: 800; color: #176447; }
  .mini-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 0 24px; }
  .mini-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mini-card { background: #fff; border: 1px solid #e1e6ef; border-radius: 10px; padding: 18px; }
  .stack { display: flex; flex-direction: column; gap: 12px; }
  .filter-box { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; margin-bottom: 14px; padding: 0 24px; }
  .filter-box input { flex: 1; min-width: 200px; padding: 13px; border: 1px solid #d8dee9; border-radius: 8px; font-size: 14px; background: #fff; }
  .search-btn { background: #101a2d; color: #fff; border: none; padding: 13px 20px; border-radius: 8px; font-weight: 800; cursor: pointer; }
  .weather-result { background: #fff; border: 1px solid #e1e6ef; border-radius: 10px; padding: 18px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: 0 24px; }
  .closing-banner { margin-top: 44px; background: #101a2d; color: #fff; border-radius: 12px; padding: 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .closing-banner h2 { color: #fff; }
  .closing-link { color: #ffc66d; font-weight: 800; text-decoration: none; }
  .site-footer { background: #071a35; color: #d8e1ef; padding: 36px 5.8% 20px; }
  .footer-inner { max-width: 1260px; margin: 0 auto; display: grid; grid-template-columns: 1.5fr .9fr 1fr; gap: 54px; }
  .footer-brand { font-size: clamp(24px,2.7vw,36px); }
  .footer-about p { max-width: 440px; margin: 12px 0 0; line-height: 1.5; color: #d8e1ef; }
  .footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }
  .footer-column h2 { margin: 0 0 8px; font-size: 20px; color: #fff; }
  .footer-column a,.footer-column span { color: #d8e1ef; text-decoration: none; font-size: 15px; }
  .footer-column a:hover,.footer-bottom a:hover { color: #ffc54d; }
  .footer-bottom { max-width: 1260px; margin: 28px auto 0; padding-top: 14px; border-top: 1px solid #ffffff30; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; }
  .footer-bottom a { color: #d8e1ef; text-decoration: none; }
  .footer-links { display: flex; gap: 18px; justify-content: center; margin: 12px 0; }
  .footer-top { display: inline-block; font-size: 13px; }
  @media (max-width: 900px) {
    .latest-news-grid { grid-template-columns: 1fr 1fr; }
    .featured-news-card { grid-column: span 2; }
    .header-inner { flex-wrap: wrap; min-height: 78px; }
    .menu-toggle { display: block; }
